# devel ships the unversioned .so symlink; rpmlint follows it to the SONAME.
# A Requires on that SONAME is dropped because the symlink lives in devel.
# unused-rpmlintrc-filter is needed so the src.rpm check does not fail
# when no-library-dependency-for is unused there.
addFilter("no-library-dependency-for")
addFilter("unused-rpmlintrc-filter")
